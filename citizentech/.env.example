# Copie este arquivo para .env e preencha com os seus valores.
# O .env NAO vai para o Git.

# Oracle FIAP
DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL
DB_USERNAME=rm000000
DB_PASSWORD=sua-senha

# RabbitMQ (local via Docker: usuario e senha padrao guest/guest)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# OpenAI (Spring AI)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# JWT: no minimo 32 caracteres aleatorios
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRATION_MINUTES=120

# Segredo do HMAC do UID do cartao e do token do totem (nao troque depois de ter dados)
HASH_SECRET=troque-por-outro-segredo-longo-e-aleatorio

# Primeiro GESTOR, criado ao subir a aplicacao se o e-mail ainda nao existir (opcional)
GESTOR_NOME=Gestor Parada Certa
GESTOR_EMAIL=gestor@paradacerta.com
GESTOR_SENHA=troque-esta-senha
